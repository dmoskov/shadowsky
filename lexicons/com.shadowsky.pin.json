{
  "lexicon": 1,
  "id": "com.shadowsky.pin",
  "defs": {
    "main": {
      "type": "record",
      "description": "A pinned post on the user's profile",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["postUri", "postCid", "pinnedAt", "order"],
        "properties": {
          "postUri": {
            "type": "string",
            "format": "at-uri",
            "description": "URI of the pinned post"
          },
          "postCid": {
            "type": "string",
            "description": "CID of the pinned post"
          },
          "pinnedAt": {
            "type": "string",
            "format": "datetime",
            "description": "When the post was pinned"
          },
          "order": {
            "type": "integer",
            "description": "Display order of the pinned post (lower numbers appear first)"
          }
        }
      }
    }
  }
}
