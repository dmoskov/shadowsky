{
  "name": "bsky-notifications-app",
  "private": true,
  "version": "0.7.4",
  "type": "module",
  "scripts": {
    "analyze": "ANALYZE=true npm run build:app && open bundle-stats.html",
    "build": "wireit",
    "build:app": "wireit",
    "build:ci": "wireit",
    "deps:check": "npm outdated || true",
    "deps:audit": "npm audit --production",
    "deps:audit:all": "npm audit",
    "deps:update:check": "echo 'Checking for updates...' && npm outdated && echo '\nRun npm:deps:update:safe to update non-breaking versions'",
    "deps:update:safe": "npm update --save",
    "dev": "vite",
    "dev:all": "./dev-all.sh",
    "dev:api": "node server/api-server.js",
    "fix": "wireit",
    "fix:format": "wireit",
    "fix:lint": "wireit",
    "preview": "vite preview",
    "test": "wireit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:a11y": "playwright test --grep @accessibility --reporter=html,json",
    "test:perf": "npm run build:app && PERFORMANCE_TEST=true playwright test --grep @performance --reporter=html",
    "test:perf:headed": "npm run build:app && PERFORMANCE_TEST=true playwright test --grep @performance --headed",
    "test:format": "wireit",
    "test:lint": "wireit",
    "test:types": "wireit",
    "test:unit": "wireit",
    "test:unit:watch": "vitest watch"
  },
  "dependencies": {
    "@atproto/api": "^0.18.8",
    "@atproto/oauth-client-browser": "^0.3.37",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/dompurify": "3.0.5",
    "@types/node": "^24.2.1",
    "@types/react-window": "^1.8.8",
    "aws-amplify": "^6.15.9",
    "date-fns": "^3.0.0",
    "dexie": "^4.2.1",
    "dompurify": "3.3.0",
    "hls.js": "^1.6.7",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.0.2",
    "react-swipeable": "^7.0.2",
    "react-window": "^2.2.3",
    "web-vitals": "^5.1.0",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@aws-amplify/backend-cli": "^1.8.1",
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.32.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.23",
    "axe-core": "^4.11.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.32",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.4",
    "wireit": "^0.14.12",
    "zod": "^3.25.17"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-tailwindcss"
    ]
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:app",
        "test:types"
      ]
    },
    "build:ci": {
      "dependencies": [
        "build:app"
      ]
    },
    "build:app": {
      "command": "vite build",
      "files": [
        "src/**/*",
        "vite.config.ts",
        "tsconfig.json",
        "postcss.config.js",
        "tailwindcss.config.js",
        "index.html"
      ],
      "output": [
        "dist/**/*"
      ]
    },
    "fix": {
      "dependencies": [
        "fix:format",
        "fix:lint"
      ]
    },
    "fix:format": {
      "command": "prettier --cache --write '*.{html,js,md,ts,yml}' '.github/workflows/*.yml' 'docs/**/*.md' 'server/**/*.js' 'src/**/*.{ts,tsx,css}' 'tests/**/*.{js,md,ts}'"
    },
    "fix:lint": {
      "command": "eslint --color --cache --fix src '*.{js,ts}'"
    },
    "test": {
      "dependencies": [
        "build:app",
        "test:format",
        "test:lint",
        "test:types",
        "test:unit"
      ]
    },
    "test:unit": {
      "command": "vitest run",
      "files": [
        "src/**/*.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "vitest.config.ts"
      ]
    },
    "test:format": {
      "command": "prettier --cache --check '*.{html,js,md,ts,yml}' '.github/workflows/*.yml' 'docs/**/*.md' 'server/**/*.js' 'src/**/*.{ts,tsx,css}' 'tests/**/*.{js,md,ts}'",
      "files": [
        "*.{html,js,md,ts,yml}",
        ".github/workflows/*.yml",
        "docs/**/*.md",
        "server/**/*.js",
        "src/**/*.{ts,tsx,css}",
        "tests/**/*.{js,md,ts}"
      ]
    },
    "test:lint": {
      "command": "eslint --color --cache src '*.{js,ts}'",
      "files": [
        "*.{js,ts}",
        "src/**/*.{ts,tsx}",
        "eslint.config.js"
      ],
      "output": []
    },
    "test:types": {
      "command": "tsc --build --pretty",
      "files": [
        "src/**/*.{ts,tsx}",
        "vite.config.ts",
        "tsconfig.json"
      ]
    }
  }
}
