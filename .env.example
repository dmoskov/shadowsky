# Google Analytics Measurement ID
# Get this from your Google Analytics property settings
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Giphy API Configuration
# Get your API key from https://developers.giphy.com/
VITE_GIPHY_API_KEY=your_giphy_api_key_here

# Anthropic API Configuration
# Get your API key from https://console.anthropic.com/
# Required for automatic alt text generation
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Proxy Server Configuration
# URL of the proxy server for fetching images in production
# This is used to avoid CORS issues when generating alt text
# Default: https://api.shadowsky.io (update to your actual server URL)
VITE_PROXY_SERVER_URL=https://api.shadowsky.io