# Google Analytics Measurement ID
# Get this from your Google Analytics property settings
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Giphy API Configuration
# Get your API key from https://developers.giphy.com/

# Anthropic API Configuration
# Get your API key from https://console.anthropic.com/
# Required for automatic alt text generation
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Proxy Server Configuration
# URL of the proxy server for fetching images in production
# This is used to avoid CORS issues when generating alt text
# Default: https://api.shadowsky.io (update to your actual server URL)
VITE_PROXY_SERVER_URL=https://api.shadowsky.io

# WebSocket Configuration
# WebSocket URL for real-time notifications
# Format: ws://localhost:3001 (local) or wss://your-domain.com (production)
# Leave empty to disable WebSocket functionality
VITE_WS_URL=ws://localhost:3001

# Test credentials (for automated testing only)
VITE_TEST_PASSWORD=your_test_password_here

# Web Push Notification Configuration (VAPID)
# Generate keys with: npx web-push generate-vapid-keys
# These are required for browser push notifications
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your_email@example.com
