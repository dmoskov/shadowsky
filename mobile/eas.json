{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "simulator": false
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "channel": "development",
      "env": {}
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-large",
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.shadowsky.io",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      }
    },
    "testflight": {
      "distribution": "store",
      "ios": {
        "resourceClass": "m-large",
        "simulator": false,
        "autoIncrement": true
      },
      "channel": "testflight",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.shadowsky.io",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      }
    },
    "production": {
      "ios": {
        "resourceClass": "m-medium",
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.shadowsky.io"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "appleId": "dustin.moskovitz@gmail.com",
        "ascAppId": "6738274061",
        "appleTeamId": "P8T66U743T"
      }
    },
    "production": {
      "ios": {
        "appleId": "dustin.moskovitz@gmail.com",
        "ascAppId": "6738274061",
        "appleTeamId": "P8T66U743T"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
